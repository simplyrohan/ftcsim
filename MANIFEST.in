include LICENSE PROTOCOL.md setup.py
recursive-include scripts *.py
recursive-include src/ftcsim *.py *.txt
graft driver-station
prune driver-station/node_modules
prune driver-station/.svelte-kit
prune driver-station/build
prune src/ftcsim/web
graft sdk
prune sdk/.gradle
prune src/ftcsim/sdk
global-exclude __pycache__ *.py[cod] .DS_Store

prune sdk/*/build
prune sdk/*/.gradle
prune sdk/*/*/build
prune sdk/*/*/.gradle

prune sdk/build
exclude sdk/local.properties
